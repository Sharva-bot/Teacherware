{
  "entities": {
    "students": {
      "description": "Student profiles and tag assignments",
      "fields": {
        "name": {
          "type": "string",
          "description": "Student full name",
          "required": true
        },
        "rollNumber": {
          "type": "string",
          "description": "Student roll/ID number",
          "required": true
        },
        "grade": {
          "type": "string",
          "description": "Student's grade and section",
          "required": true
        },
        "tags": {
          "type": "array",
          "description": "Classroom behavior and seating tags assigned to student",
          "required": true
        },
        "notes": {
          "type": "string",
          "description": "Additional notes about the student's behavior or setup",
          "required": false
        },
        "joinedDate": {
          "type": "string",
          "description": "Date student was enrolled",
          "required": false
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Creation timestamp",
          "required": false
        }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    "classroom": {
      "description": "Classroom physical assets and boundary settings",
      "fields": {
        "smartBoardLocation": {
          "type": "string",
          "description": "The wall where the Smart Board is located (Front, Back, Left, Right)",
          "required": true
        },
        "doorLocation": {
          "type": "string",
          "description": "The entrance doorway position",
          "required": true
        },
        "teacherDeskLocation": {
          "type": "string",
          "description": "The teacher desk placement coordinate",
          "required": true
        },
        "windowLocations": {
          "type": "array",
          "description": "The walls containing windows",
          "required": true
        },
        "customNotes": {
          "type": "string",
          "description": "Specific classroom arrangement notes passed to Gemini",
          "required": false
        },
        "updatedAt": {
          "type": "timestamp",
          "description": "Last updated timestamp",
          "required": false
        }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    "materials": {
      "description": "Textbook materials, generated study guides and test papers",
      "fields": {
        "title": {
          "type": "string",
          "description": "The title of the chapter/material",
          "required": true
        },
        "images": {
          "type": "array",
          "description": "Array of base64 compressed textbook images",
          "required": true
        },
        "studyGuide": {
          "type": "string",
          "description": "Markdown study guide text generated by Gemini",
          "required": false
        },
        "testPaper": {
          "type": "string",
          "description": "Markdown test paper questions and answers generated by Gemini",
          "required": false
        },
        "status": {
          "type": "string",
          "description": "Generation status",
          "required": true
        },
        "error": {
          "type": "string",
          "description": "Error description if generation failed",
          "required": false
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Creation timestamp",
          "required": true
        }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    "seating": {
      "description": "Active classroom seating arrangement and custom seating mandates",
      "fields": {
        "assignments": {
          "type": "array",
          "description": "List of bench seat assignments for students",
          "required": true
        },
        "customRules": {
          "type": "array",
          "description": "List of active seating constraints and mandates (separate, pair, lock)",
          "required": true
        },
        "strategy": {
          "type": "string",
          "description": "Active seating optimization strategy mode",
          "required": true
        },
        "harmonyAnalysis": {
          "type": "object",
          "description": "Harmony analysis score and bench insights",
          "required": false
        },
        "reasoning": {
          "type": "array",
          "description": "AI placement rationale items",
          "required": false
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last arrangement update",
          "required": true
        }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    "cheatingAlerts": {
      "description": "Cheating detection warnings flagged between adjacent seated students",
      "fields": {
        "examId": {
          "type": "string",
          "description": "ID of the exam record evaluated",
          "required": true
        },
        "examTitle": {
          "type": "string",
          "description": "Title of the exam",
          "required": true
        },
        "student1Id": {
          "type": "string",
          "description": "ID of first student involved in cheating alert",
          "required": true
        },
        "student1Name": {
          "type": "string",
          "description": "Name of first student",
          "required": true
        },
        "student2Id": {
          "type": "string",
          "description": "ID of second student involved in cheating alert",
          "required": true
        },
        "student2Name": {
          "type": "string",
          "description": "Name of second student",
          "required": true
        },
        "benchId": {
          "type": "string",
          "description": "ID of bench where cheating occurred",
          "required": true
        },
        "benchName": {
          "type": "string",
          "description": "Name of bench",
          "required": true
        },
        "similarityPercentage": {
          "type": "number",
          "description": "Similarity percentage (0-100)",
          "required": true
        },
        "suspicionLevel": {
          "type": "string",
          "description": "Suspicion severity level (high, medium, low)",
          "required": true
        },
        "identicalMistakes": {
          "type": "array",
          "description": "Questions where identical mistakes were detected",
          "required": false
        },
        "summary": {
          "type": "string",
          "description": "Detailed explanation of cheating detection evidence",
          "required": true
        },
        "status": {
          "type": "string",
          "description": "Alert status (active_warning, separated, dismissed)",
          "required": true
        },
        "detectedAt": {
          "type": "string",
          "description": "ISO timestamp when cheating was detected",
          "required": true
        }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    }
  }
}

