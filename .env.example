# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in GitHub Secrets or server environment as GEMINI_API_KEY.
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: Server listening port (default: 3000)
PORT=3000

# APP_URL: The public hosted URL of the application.
APP_URL="http://localhost:3000"

# Firebase Client Configuration (GitHub Actions / Deployment Environment Variables)
# Prefix with VITE_ for Vite client-side access
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_auth_domain"
VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_storage_bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_firebase_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="your_firestore_database_id"

